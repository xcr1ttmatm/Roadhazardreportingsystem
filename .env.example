# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# MapTiler basemap (optional but recommended)
# Free key: https://cloud.maptiler.com/account/keys/
# Restrict the key to your domains (localhost + deployed host) in MapTiler.
# If this is empty, the app automatically falls back to the keyless Esri basemap.
VITE_MAPTILER_KEY=
# MapTiler style / map ID. Set this to a custom "roads only" style ID if you
# create one in MapTiler Cloud. Defaults to streets-v4 when unset.
#   streets-v4  full street network + names + POIs (recommended)
#   base-v4     clean roads, fewer POIs
#   outdoor-v4  adds footpaths and trails
#   dataviz-v4  minimal (hides most streets)
VITE_MAPTILER_STYLE=streets-v4
